# Copy to .env (gitignored). Read at configure time by main/CMakeLists.txt.

# Root of the Waveshare reference examples
EXAMPLE_PATH=""

# 1: on the first boot of a newly built firmware, set the RTC to the build
#    machine's local time. 0: never touch the RTC.
RTC_SYNC=1

# Seconds added to the build time to cover the build -> flash -> boot delay.
RTC_SYNC_OFFSET_S=30
